<div class="sidebar-item-inner">
{{!--     <div class="sidebar-row sidebar-item-title">
        <h2 class="sidebar-item-title-inner">
            Component Edit
        </h2>
    </div> --}}
        <div class="separator"></div>
        <button class="editor-component-edit-sidebar-save action-primary">
            <span class="editor-component-edit-sidebar-save-inner">
                {{t 'app.save'}}
            </span>
        </button>
        <button class="editor-component-edit-sidebar-cancel action-secondary">
            <span class="editor-component-edit-sidebar-cancel-inner">
                {{t 'app.cancel'}}
            </span>
        </button>
        <div class="separator"></div>
        <div class="editor-slides-import display-none">
            <button type="button" class="editor-slides-import-button action-secondary">
                <span>{{t 'app.importpptx'}}</span>
            </button>
            <input type="file" class="editor-slides-import-file display-none" accept=".pptx" aria-label="{{t 'app.importpptx'}}">
            <p class="editor-slides-import-help">{{t 'app.importpptxhelp'}}</p>
        </div>
        <div class="editor-h5p-library display-none">
            <button type="button" class="editor-h5p-library-button action-secondary">
                <span>{{t 'app.h5plibrarybutton'}}</span>
            </button>
            <p class="editor-h5p-library-help">{{t 'app.h5plibraryhelp'}}</p>
        </div>
</div>
